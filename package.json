{
  "name": "mldong-flow-designer-plus",
  "private": false,
  "version": "2.0.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vue-tsc -b && vite build --config vite.config.lib.ts",
    "preview": "vite preview"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.62.3",
    "@rollup/rollup-linux-x64-gnu": false
  },
  "keywords": [
    "工作流",
    "流程设计器",
    "Web流程设计器",
    "Vue3",
    "LogicFlow",
    "Element Plus",
    "Ant Design of Vue3"
  ],
  "main": "./lib/mldong-flow-designer-plus.umd.cjs",
  "module": "./lib/mldong-flow-designer-plus.js",
  "types": "./packages/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/types/index.d.ts",
      "import": "./lib/mldong-flow-designer-plus.js",
      "require": "./lib/mldong-flow-designer-plus.umd.cjs"
    },
    "./lib/style.css": "./lib/style.css",
    "./*": "./*"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@logicflow/core": "^2.2.3",
    "@logicflow/extension": "^2.2.3",
    "@logicflow/layout": "^2.1.3",
    "ant-design-vue": "4.x",
    "element-plus": "^2.7.8",
    "vue": "^3.4.30",
    "vue-json-pretty": "^2.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "sass": "^1.100.0",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vue-tsc": "2.0.22"
  },
  "peerDependencies": {
    "ant-design-vue": "^4.0.0",
    "element-plus": "^2.0.0",
    "vue": "^3.4.0"
  },
  "license": "MIT",
  "homepage": "https://gitee.com/mldong/mldong-flow-designer-plus",
  "repository": {
    "type": "git",
    "url": "git@gitee.com:mldong/mldong-flow-designer-plus.git"
  }
}
