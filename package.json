{
  "name": "mldong-flow-designer-plus",
  "private": false,
  "version": "2.0.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "ROLLUP_SKIP_NATIVE=true vue-tsc -b && vite build --config vite.config.lib.ts",
    "preview": "vite preview"
  },
  "keywords": [
    "工作流",
    "流程设计器",
    "Web流程设计器",
    "Vue3",
    "LogicFlow",
    "Element Plus",
    "Ant Design of Vue3"
  ],
  "main": "./lib/mldong-flow-designer-plus.umd.cjs",
  "module": "./lib/mldong-flow-designer-plus.js",
  "types": "./packages/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/types/index.d.ts",
      "import": "./lib/mldong-flow-designer-plus.js",
      "require": "./lib/mldong-flow-designer-plus.umd.cjs"
    },
    "./lib/style.css": "./lib/style.css",
    "./lib/*": "./lib/*"
  },
  "files": [
    "lib",
    "packages"
  ],
  "author": "mldong",
  "license": "Apache License 2.0",
  "homepage": "https://www.npmjs.com/package/mldong-flow-designer-plus",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/mldong/flow-designer.git"
  },
  "bugs": {
    "url": "https://gitee.com/mldong/flow-designer/issues"
  },
  "dependencies": {
    "@logicflow/core": "^2.2.3",
    "@logicflow/extension": "^2.2.3",
    "@logicflow/layout": "^2.1.3",
    "ant-design-vue": "4.x",
    "element-plus": "^2.7.8",
    "vue": "^3.4.30",
    "vue-json-pretty": "^2.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "sass": "^1.100.0",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vue-tsc": "2.0.22"
  }
}
